{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "bzdium",
  "version": "0.2.6",
  "identifier": "com.bzdium.app",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "bzdium",
        "width": 1280,
        "height": 800,
        "minWidth": 480,
        "minHeight": 400
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self'; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "shortDescription": "Lightweight multi-messenger (Ferdium concept in Rust)",
    "longDescription": "bzdium — all your messengers in one light window. A from-scratch Rust/WebView2 re-implementation of the Ferdium concept: isolated per-service sessions, unread badges, hibernation, portable single-exe or installed.",
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0 | libwebkit2gtk-4.0-37",
          "libgtk-3-0",
          "libayatana-appindicator3-1 | libappindicator3-1"
        ]
      },
      "rpm": {
        "depends": [
          "webkit2gtk4.1",
          "gtk3",
          "libayatana-appindicator3-1"
        ]
      }
    },
    "windows": {
      "nsis": {
        "installMode": "both",
        "languages": ["English"],
        "displayLanguageSelector": false
      }
    }
  }
}
