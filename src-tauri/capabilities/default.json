{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "bzdium UI webview (local): access to all app commands.",
  "windows": ["main"],
  "permissions": [
    "core:event:default",
    "core:app:default",
    "allow-get-state",
    "allow-update-settings",
    "allow-get-recipes",
    "allow-add-service",
    "allow-update-service",
    "allow-remove-service",
    "allow-reorder-services",
    "allow-set-active-service",
    "allow-reload-service",
    "allow-navigate",
    "allow-hibernate-service",
    "allow-wake-service",
    "allow-set-overlay-mode",
    "allow-navigate-url",
    "allow-export-config",
    "allow-import-config",
    "allow-open-devtools",
    "allow-open-service-external",
    "allow-pick-service-icon",
    "allow-reset-service-icon",
    "allow-get-service-icon",
    "allow-get-agent-status",
    "allow-set-agent-admin-scope",
    "allow-mint-agent-token",
    "allow-revoke-agent-tokens",
    "allow-list-webview2-runtimes",
    "allow-open-url-external",
    "allow-grok-key-status",
    "allow-grok-save-key",
    "allow-grok-delete-key",
    "allow-grok-test-connection",
    "allow-grok-send-message",
    "allow-grok-cancel-request",
    "allow-grok-list-conversations",
    "allow-grok-save-conversation",
    "allow-grok-clear-history"
  ]
}
