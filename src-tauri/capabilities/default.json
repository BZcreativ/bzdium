{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "bzdium UI webview (local): access to all app commands.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "allow-get-state",
    "allow-get-settings",
    "allow-update-settings",
    "allow-get-recipes",
    "allow-add-service",
    "allow-update-service",
    "allow-remove-service",
    "allow-reorder-services",
    "allow-set-active-service",
    "allow-reload-service",
    "allow-navigate",
    "allow-hibernate-service",
    "allow-wake-service",
    "allow-set-overlay-mode",
    "allow-navigate-url",
    "allow-export-config",
    "allow-import-config"
  ]
}
